# Konfigurasi frontend Notula Assistent (safe untuk VITE_* — tanpa secret).
# Aturan: JANGAN pernah menaruh API key/secret di frontend.
# Provider AI/STT berbayar dipanggil lewat backend (Batch 12).

# Nama aplikasi
VITE_APP_NAME=Notula Assistent

# Mode penyimpanan: device (default) | device_cloud
VITE_STORAGE_MODE=device

# Provider transkripsi: whisper-web (default) | local-dev | server
#   whisper-web = Whisper in-browser lewat @huggingface/transformers (tanpa API key;
#                 unduhan model ~40 MB sekali lalu di-cache browser)
#   local-dev   = tanpa eksternal, chunk ditandai menunggu diproses (jujur, bukan palsu)
VITE_SPEECH_PROVIDER=whisper-web

# Provider diarization pembicara: vad-local (default) | local-dev
#   vad-local  = VAD energi + fitur akustik (ZCR/spectral centroid) langsung dari
#                audio — memisahkan giliran bicara jadi speaker_1..N (BUKAN identifikasi
#                identitas orang; nama diberikan manual oleh pengguna)
#   local-dev  = tanpa diarization, hasil jujur "belum tersedia"
VITE_DIARIZATION_PROVIDER=vad-local

# Provider AI ringkasan: extractive (default) | local-dev | server
#   extractive = ekstraksi offline murni dari transkrip (kalimat, frasa, keputusan,
#                PIC, deadline) + guard anti-hallucination — tanpa API key & jaringan;
#                BUKAN LLM generatif, hanya memakai kalimat yang ada di transkrip
#   local-dev  = tanpa AI, hasil jujur "belum tersedia"
#   server     = reserved untuk backend (Batch 12)
VITE_AI_PROVIDER=extractive

# Base URL backend opsional. Kosong = mode lokal penuh (offline-first).
# Diisi → kartu "Sinkronisasi Cloud" di Pengaturan aktif (antrean unggah
# endpoint PRD §39); dikosongkan → antrean menunggu dengan jujur, bukan gagal.
VITE_API_BASE_URL=
